<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
    <style>
      /* ── Voicebot layout ── */
      .vb-layout {
        display: flex;
        flex-direction: column;
        height: calc(100vh - var(--topbar-h));
        max-width: 720px;
        margin: 0 auto;
        width: 100%;
      }

      /* ── Chat area ── */
      .vb-chat {
        flex: 1;
        overflow-y: auto;
        padding: 24px 20px 12px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        scrollbar-width: thin;
        scrollbar-color: var(--border-2) transparent;
      }

      .vb-chat:empty::after {
        content: 'Press TALK ↓ to start the conversation.';
        display: block;
        text-align: center;
        color: var(--text-dim);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-top: 40px;
      }

      /* ── Chat bubbles ── */
      .vb-bubble {
        display: flex;
        flex-direction: column;
        gap: 4px;
        max-width: 80%;
      }

      .vb-bubble--user {
        align-self: flex-end;
        align-items: flex-end;
      }

      .vb-bubble--assistant {
        align-self: flex-start;
        align-items: flex-start;
      }

      .vb-bubble__role {
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 2px;
      }

      .vb-bubble--user .vb-bubble__role   { color: var(--neon-cyan);   }
      .vb-bubble--assistant .vb-bubble__role { color: var(--neon-orange); }

      .vb-bubble__text {
        padding: 10px 14px;
        border: 2px solid;
        font-size: 13px;
        line-height: 1.55;
      }

      .vb-bubble--user .vb-bubble__text {
        border-color: var(--neon-cyan);
        background: var(--customer-soft);
        color: var(--text);
        box-shadow: 3px 3px 0 var(--neon-cyan);
      }

      .vb-bubble--assistant .vb-bubble__text {
        border-color: var(--neon-orange);
        background: var(--agent-soft);
        color: var(--text);
        box-shadow: 3px 3px 0 var(--neon-orange);
      }

      /* ── Bottom chrome ── */
      .vb-bottom {
        flex-shrink: 0;
        border-top: 2px solid var(--border-2);
        background: var(--surface);
      }

      /* ── Live draft ── */
      .vb-draft {
        padding: 10px 20px;
        border-bottom: 1px solid var(--border);
        font-size: 12px;
        color: var(--neon-cyan);
        min-height: 36px;
        display: flex;
        gap: 10px;
        align-items: baseline;
      }

      .vb-draft__label {
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--recording);
        flex-shrink: 0;
      }

      .vb-draft__label::before {
        content: '● ';
        animation: blink 1s step-start infinite;
      }

      @keyframes blink { 50% { opacity: 0; } }

      .vb-draft__text {
        color: var(--text-muted);
        font-style: italic;
      }

      /* ── Controls bar ── */
      .vb-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 16px 20px;
      }

      /* ── Mic button ── */
      .vb-mic-btn {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 88px;
        height: 88px;
        border: 3px solid var(--neon-green);
        border-radius: 50%;
        background: transparent;
        color: var(--neon-green);
        cursor: pointer;
        font: inherit;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        box-shadow: 0 0 14px rgba(0, 255, 159, 0.25), inset 0 0 14px rgba(0, 255, 159, 0.06);
        transition: box-shadow 120ms, transform 80ms;
        position: relative;
      }

      .vb-mic-btn:hover:not(:disabled) {
        box-shadow: 0 0 24px rgba(0, 255, 159, 0.55), inset 0 0 20px rgba(0, 255, 159, 0.12);
        transform: scale(1.04);
      }

      .vb-mic-btn:disabled {
        opacity: 0.35;
        cursor: not-allowed;
        box-shadow: none;
      }

      .vb-mic-btn--recording {
        border-color: var(--recording);
        color: var(--recording);
        box-shadow: 0 0 20px rgba(255, 45, 120, 0.5), inset 0 0 20px rgba(255, 45, 120, 0.12);
        animation: pulse-ring 1.4s ease-out infinite;
      }

      @keyframes pulse-ring {
        0%   { box-shadow: 0 0 0 0   rgba(255, 45, 120, 0.55), inset 0 0 14px rgba(255, 45, 120, 0.1); }
        60%  { box-shadow: 0 0 0 14px rgba(255, 45, 120, 0),   inset 0 0 14px rgba(255, 45, 120, 0.1); }
        100% { box-shadow: 0 0 0 14px rgba(255, 45, 120, 0),   inset 0 0 14px rgba(255, 45, 120, 0.1); }
      }

      .vb-mic-icon {
        pointer-events: none;
      }

      /* ── Stop button ── */
      .vb-stop-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 18px;
        border: 2px solid var(--border-2);
        background: var(--surface-3);
        color: var(--text-muted);
        font: inherit;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
        box-shadow: 3px 3px 0 var(--border-2);
        transition: transform 80ms, box-shadow 80ms;
      }

      .vb-stop-btn:hover:not(:disabled) {
        color: var(--text);
        transform: translate(-2px, -2px);
        box-shadow: 5px 5px 0 var(--border-2);
      }

      /* ── Thinking indicator ── */
      .vb-thinking {
        display: flex;
        gap: 5px;
        padding: 10px 20px;
        align-items: center;
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--neon-orange);
      }

      .vb-thinking__dots span {
        animation: dot-bounce 1.2s ease-in-out infinite;
        display: inline-block;
      }

      .vb-thinking__dots span:nth-child(2) { animation-delay: 0.15s; }
      .vb-thinking__dots span:nth-child(3) { animation-delay: 0.30s; }

      @keyframes dot-bounce {
        0%, 60%, 100% { transform: translateY(0); }
        30%            { transform: translateY(-4px); }
      }

      /* ── Back link in topbar ── */
      .vb-back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border: 2px solid var(--border-2);
        background: var(--surface-3);
        color: var(--text-muted);
        font: inherit;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-decoration: none;
        box-shadow: 3px 3px 0 var(--border-2);
        transition: transform 80ms, box-shadow 80ms, color 80ms;
      }

      .vb-back-link:hover {
        color: var(--text);
        transform: translate(-2px, -2px);
        box-shadow: 5px 5px 0 var(--border-2);
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="app-layout">

      <!-- ── Top bar ── -->
      <header class="topbar">
        <div class="topbar__brand">
          <span class="topbar__logo" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"><path d="M12 2a3 3 0 0 1 3 3v7a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
          </span>
          <div>
            <div class="topbar__name">Voicebot</div>
            <div class="topbar__subtitle">Soniox &middot; OpenAI &middot; ElevenLabs</div>
          </div>
        </div>

        <div class="topbar__controls">
          <a class="vb-back-link" href="/">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Transcript app
          </a>
        </div>
      </header>

      <!-- ── Main voicebot area ── -->
      <div class="vb-layout">

        <!-- Chat bubbles -->
        <div class="vb-chat" data-vb-chat aria-live="polite"></div>

        <!-- Bottom chrome -->
        <div class="vb-bottom">

          <!-- Live draft -->
          <div class="vb-draft" data-vb-draft hidden>
            <span class="vb-draft__label">Live</span>
            <span class="vb-draft__text" data-vb-draft-text>Listening&hellip;</span>
          </div>

          <!-- Thinking indicator -->
          <div class="vb-thinking" data-vb-thinking hidden>
            <span>Thinking</span>
            <span class="vb-thinking__dots">
              <span>.</span><span>.</span><span>.</span>
            </span>
          </div>

          <!-- Status bar -->
          <div class="status-bar" data-vb-status>
            <span class="status-bar__dot" aria-hidden="true"></span>
            <span class="status-bar__text" data-vb-status-text>Press TALK to start the conversation.</span>
            <span class="status-bar__error" data-vb-error></span>
          </div>

          <!-- Controls -->
          <div class="vb-controls">
            <button class="vb-mic-btn" type="button" data-vb-mic aria-label="Talk">
              <svg class="vb-mic-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M12 2a3 3 0 0 1 3 3v7a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
              <span data-vb-mic-label>Talk</span>
            </button>

            <button class="vb-stop-btn" type="button" data-vb-stop hidden aria-label="Stop recording">
              &#9632; Stop
            </button>
          </div>

        </div>
      </div>

    </div>

    <script type="module" src="/voicebot.js"></script>
  </body>
</html>
