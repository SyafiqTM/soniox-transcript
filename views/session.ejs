<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="session-page">

    <header class="topbar">
      <div class="topbar__brand">
        <span class="topbar__logo" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"><path d="M12 2a3 3 0 0 1 3 3v7a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
        </span>
        <div>
          <div class="topbar__name">Soniox Transcript</div>
          <div class="topbar__subtitle">Saved Session</div>
        </div>
      </div>
    </header>

    <div class="session-content">
      <header class="session-header">
        <p class="session-header__eyebrow">Saved Transcript</p>
        <h1 class="session-header__title"><%= session.id %></h1>
        <p class="session-header__meta">
          Started <%= new Date(session.startedAt).toLocaleString() %>
          &nbsp;&middot;&nbsp; Model: <%= session.model %>
          &nbsp;&middot;&nbsp; <%= session.turns.length %> turn<%= session.turns.length !== 1 ? 's' : '' %>
        </p>
      </header>

      <div class="session-turns">
        <% session.turns.forEach((turn) => { %>
          <div class="turn-card turn-card--<%= turn.role %>">
            <p class="turn-card__role"><%= turn.role === 'customer' ? 'Customer' : 'Agent' %></p>
            <div class="turn-card__bubble"><%= turn.text %></div>
            <p class="turn-card__time"><%= new Date(turn.endedAt).toLocaleTimeString() %></p>
          </div>
        <% }) %>
      </div>

      <a class="back-link" href="/">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to simulator
      </a>
    </div>

  </body>
</html>
